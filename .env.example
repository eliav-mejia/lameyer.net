SUPABASE_JWKS_URL=https://kcxjeinzwcpgfuolxadt.supabase.co/auth/v1/.well-known/jwks.json
# Optional, for supabase/config.toml when Google / Microsoft / Turnstile / SMTP are switched on (local CLI only):
